@article{cangkramaProtumorigenicMDia2MIRO1Axis2022,
  title = {A {{Protumorigenic mDia2-MIRO1 Axis Controls Mitochondrial Positioning}} and {{Function}} in {{Cancer-Associated Fibroblasts}}},
